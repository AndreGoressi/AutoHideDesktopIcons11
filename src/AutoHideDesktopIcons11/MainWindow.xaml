<Window
    x:Class="AutoHideDesktopIcons11.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AutoHideDesktopIcons11">

    <Grid Padding="24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Spacing="12" Grid.Row="0">
            <Image Source="Assets/AppIcon.png" Width="40" Height="40"/>
            <StackPanel>
                <TextBlock Text="AutoHide Icons" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Modernes Desktop-Icon-Verstecken für Windows 11" Opacity="0.7" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- Zwei Spalten: Einstellungen / Zeigen durch Klick -->
        <Grid Grid.Row="1" ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="10">
                <TextBlock Text="Einstellungen" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <CheckBox x:Name="DisabledCheckBox" Content="Deaktivieren" Checked="OnAnySettingChanged" Unchecked="OnAnySettingChanged"/>
                <CheckBox x:Name="StartWithWindowsCheckBox" Content="Mit Windows starten" Checked="OnAnySettingChanged" Unchecked="OnAnySettingChanged"/>
                <CheckBox x:Name="StartMinimizedCheckBox" Content="Minimiert starten (Infobereich)" Checked="OnAnySettingChanged" Unchecked="OnAnySettingChanged"/>
                <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Immer im Vordergrund" Checked="OnAnySettingChanged" Unchecked="OnAnySettingChanged"/>
                <CheckBox x:Name="HideTaskbarCheckBox" Content="Taskleiste verstecken" Checked="OnAnySettingChanged" Unchecked="OnAnySettingChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="10">
                <TextBlock Text="Zeigen, durch Klick auf den Desktop:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <CheckBox x:Name="ShowOnLeftClickCheckBox" Content="Mit der linken Maustaste" Checked="OnAnySettingChanged" Unchecked="OnAnySettingChanged"/>
                <CheckBox x:Name="ShowOnMiddleClickCheckBox" Content="Mit der mittleren Maustaste" Checked="OnAnySettingChanged" Unchecked="OnAnySettingChanged"/>
                <CheckBox x:Name="ShowOnRightClickCheckBox" Content="Mit der rechten Maustaste" Checked="OnAnySettingChanged" Unchecked="OnAnySettingChanged"/>
                <CheckBox x:Name="ShowOnContextMenuCheckBox" Content="Desktop-Kontextmenü" Checked="OnAnySettingChanged" Unchecked="OnAnySettingChanged"/>

                <Expander Header="Weitere Optionen" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8" Padding="4">
                        <TextBlock Text="AutoHideDesktopIcons11" FontWeight="SemiBold"/>
                        <TextBlock Text="Freie, quelloffene Neuimplementierung im Fluent-Design für Windows 11."
                                   TextWrapping="Wrap" Opacity="0.75" FontSize="12"/>
                        <HyperlinkButton Content="Projekt auf GitHub öffnen" x:Name="GitHubLink" Click="OnGitHubLinkClick"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Grid>

        <!-- Timer / Idle-Sekunden -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Ausblenden nach Inaktivität" FontSize="12" Opacity="0.75" Margin="0,0,0,4"/>
                <Slider x:Name="IdleSecondsSlider" Minimum="3" Maximum="100" StepFrequency="1"
                        ValueChanged="OnIdleSecondsChanged"/>
            </StackPanel>

            <TextBlock Grid.Column="1" x:Name="IdleSecondsLabel" Text="5 Sek." VerticalAlignment="Bottom" Width="70" TextAlignment="Right"/>
        </Grid>

        <!-- Live-Statusanzeige, entspricht dem "Timer"-Balken im Original -->
        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock Text="Timer:" FontSize="12" Opacity="0.75"/>
            <ProgressBar x:Name="IdleProgressBar" Minimum="0" Maximum="1" Value="0"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="StatusText" VerticalAlignment="Bottom" Opacity="0.6" FontSize="11"
                   Text="Läuft im Infobereich weiter, wenn das Fenster geschlossen wird."/>
    </Grid>
</Window>
